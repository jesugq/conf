# spq
QUEEN_DIR=~/Development
function spq() {
	cd $QUEEN_DIR
}

# spd
DOCKER_DIR=~/Development/docker-dev
function spd() {
	cd $DOCKER_DIR
}
function spdapp() {
  cd $DOCKER_DIR
  git pull
  sp apps:sync
  sp stop
  sp start
}
function spdaws() {
	cd $DOCKER_DIR
  aws sso login --profile staging
}
function spdssh() {
	cd $DOCKER_DIR
	ssh-add ~/.ssh/id_ed25519
}

# spb
BACKEND_DIR=~/Development/simplepractice
BACKEND_APP=simplepractice
spb() {
	cd $BACKEND_DIR
}
function spbrld() {
	sp restart --backend
}
function spblog() {
	sp attach --backend
}
function spbdb() {
	sp exec mysql -h mysql.local -u root $BACKEND_APP
}
function spbcop() {
	sp rubocop -a $BACKEND_APP "$@"
}
function spbspec() {
	if [ $1 = true ]; then
		shift
		docker exec -it -e COVERAGE=true $BACKEND_APP bundle exec rspec "$@"
	else
		shift
		docker exec -it $BACKEND_APP bundle exec rspec "$@"
	fi
}
function spboas() {
	sp exec -a $BACKEND_APP rails 'oas:generate[spec/acceptance/frontend/users_spec.rb,spec/acceptance/frontend/team_members_spec.rb]'
}

# spf
FRONTEND_DIR=~/Development/simplepractice/frontend
FRONTEND_APP=simplepractice-frontend
function spf() {
	cd $FRONTEND_DIR
}
function spfrld() {
	sp restart --frontend
}
function spflog() {
	sp attach --frontend
}
function spfyarn() {
	if [ $1 = true ]; then
		shift
    sp exec -a $FRONTEND_APP -e COVERAGE=true yarn test:browser "$@"
		# docker exec -it -e COVERAGE=true $FRONTEND_APP yarn test --serve -f 'dummy test'
	else
		shift
    sp exec -a simplepractice-frontend yarn test:browser "$@"
		# docker exec -it $FRONTEND_APP yarn test --serve -f 'dummy test'
	fi
}
function spflint() {
  local type="$1"
  shift
  sp exec -a $FRONTEND_APP yarn lint:"$type" "$@"
}

# sps
SSO_DIR=~/Development/sp-sso-account
SSO_APP=sp-sso-account
function sps() {
  cd $SSO_DIR
}
function spsdb() {
	sp exec mysql -h mysql.local -u root $SSO_APP
}
function spscop() {
	sp rubocop -a $SSO_APP "$@"
}
function spsspec() {
	if [ $1 = true ]; then
		shift
		docker exec -it -e COVERAGE=true $SSO_APP bundle exec rspec "$@"
	else
		shift
		docker exec -it $SSO_APP bundle exec rspec "$@"
	fi
}

# stg
function stglog() {
  sp staging:logs "$1" -f
}
function stgbash() {
  sp staging:exec "$1" bash
}
function stgrails() {
  sp staging:exec "$1" bin/rails console
}
function stgdb() {
  sp staging:db "$1"
}

# sp
function spbash() {
	sp exec bash
}
function splake(){
  sp setup:lake
  sp bin/lake-console
}
function sprails() {
	sp exec rails console
}
function sprld() {
	sp restart
}
function splog() {
	sp attach
}
