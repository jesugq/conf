# spq
QUEEN_DIR=~/Development
function spq() {
  tmux rename-window spq
	cd $QUEEN_DIR
}

# spd
DOCKER_DIR=~/Development/docker-dev
function spd() {
  tmux rename-window spd
	cd $DOCKER_DIR
}
function spdapp() {
  tmux rename-window spd
  cd $DOCKER_DIR
  git pull
  sp apps:sync
  sp stop
  sp start
}
function spdaws() {
  tmux rename-window spd
	cd $DOCKER_DIR
  aws sso login --profile staging
}
function spdssh() {
  tmux rename-window spd
	cd $DOCKER_DIR
	ssh-add ~/.ssh/id_ed25519
}

# spb
BACKEND_DIR=~/Development/simplepractice
BACKEND_APP=simplepractice
spb() {
  tmux rename-window spb
	cd $BACKEND_DIR
}
function spbrld() {
	sp restart --backend
}
function spblog() {
	sp attach --backend
}
function spbdb() {
  tmux rename-window spb
	sp exec mysql -h mysql.local -u root $BACKEND_APP
}
function spbspec() {
  tmux rename-window spb
	if [ $1 = true ]; then
		shift
		docker exec -it -e COVERAGE=true $BACKEND_APP bundle exec rspec "$@"
	else
		shift
		docker exec -it $BACKEND_APP bundle exec rspec "$@"
	fi
}

# spf
FRONTEND_DIR=~/Development/simplepractice/frontend
FRONTEND_APP=simplepractice-frontend
function spf() {
  tmux rename-window spf
	cd $FRONTEND_DIR
}
function spfrld() {
	sp restart --frontend
}
function spflog() {
	sp attach --frontend
}
function spfyarn() {
  tmux rename-window spf
	if [ $1 = true ]; then
		shift
		docker exec -it -e COVERAGE=true $FRONTEND_APP yarn test --serve -f 'dummy test'
	else
		shift
		docker exec -it $FRONTEND_APP yarn test --serve -f 'dummy test'
	fi
}

# sps
SSO_DIR=~/Development/sp-sso-account
SSO_APP=sp-sso-account
function sps() {
  tmux rename-window sps
  cd $SSO_DIR
}
function spsdb() {
  tmux rename-window sps
	sp exec mysql -h mysql.local -u root $SSO_APP
}
function spsspec() {
  tmux rename-window sps
	if [ $1 = true ]; then
		shift
		docker exec -it -e COVERAGE=true $SSO_APP bundle exec rspec "$@"
	else
		shift
		docker exec -it $SSO_APP bundle exec rspec "$@"
	fi
}

# stg
function stglog() {
  tmux rename-window "$1"
  sp staging:logs "$1" -f
}
function stgbash() {
  tmux rename-window "$1"
  sp staging:exec "$1" bash
}
function stgrails() {
  tmux rename-window "$1"
  sp staging:exec "$1" rails console
}
function stgdb() {
  tmux rename-window "$1"
  sp staging:db "$1"
}

# sp
function spbash() {
	sp exec bash
}
function splake(){
  sp setup:lake
  sp bin/lake-console
}
function sprails() {
	sp exec rails console
}
function sprld() {
	sp restart
}
function splog() {
	sp attach
}
function spcop() {
	sp rubocop "$@"
}
function spoas() {
	sp exec rails 'oas:generate[spec/acceptance/frontend/users_spec.rb,spec/acceptance/frontend/team_members_spec.rb]'
}
function spusr() {
	sp exec rails r script/marketing/create_user.rb -- "$@"
}
