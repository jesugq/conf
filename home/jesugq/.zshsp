# sp
FOLDER_DIR=~/Development/
sp_cd() {
	cd $FOLDER_DIR
}
sp_nvim() {
	sp_cd
	nvim $FOLDER_DIR
}
sp_agent() {
	sp_cd
	cursor agent
}
sp_remap() {
	hidutil property --set '{"UserKeyMapping":[
	  {"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E0},
	  {"HIDKeyboardModifierMappingSrc":0x7000000E0,"HIDKeyboardModifierMappingDst":0x7000000E0},
	  {"HIDKeyboardModifierMappingSrc":0x700000029,"HIDKeyboardModifierMappingDst":0x7000000E0}
	]}'
}

# spd
DOCKER_DIR=~/Development/docker-dev
spd_cd() {
	cd $DOCKER_DIR
}
spd_nvim() {
	spd_cd
	nvim $DOCKER_DIR
}
spd_sync() {
	spd_cd
	git pull
	sp apps:sync
	sp stop
	sp start
}
spd_ssh() {
	spd_cd
	ssh-add ~/.ssh/id_ed25519
}
alias spd_aws='aws sso login --profile staging'
alias spd_ngrok='ngrok http 4005'
alias spd_stats='docker stats'

# spb
BACKEND_DIR=~/Development/simplepractice
BACKEND_APP=simplepractice
spb_cd() {
	cd $BACKEND_DIR
}
spb_nvim() {
	spb_cd
	nvim $BACKEND_DIR
}
spb_restart() {
	sp restart -a $BACKEND_APP --backend
	spb_attach
}
spb_attach() {
	sp attach -a $BACKEND_APP
}
spb_bash() {
	sp exec -a $BACKEND_APP bash
}
spb_rails() {
	sp exec -a $BACKEND_APP rails console
}
spb_mysql() {
	sp exec -a $BACKEND_APP mysql -h mysql.local -u root $BACKEND_APP
}
spb_rspec() {
	if [ $1 = true ]; then
		shift
		docker exec -it -e COVERAGE=true $BACKEND_APP bundle exec rspec "$@"
	else
		shift
		docker exec -it $BACKEND_APP bundle exec rspec "$@"
	fi
}
spb_oas() {
	spb_cd
	sp exec -a $BACKEND_APP rails 'oas:generate[spec/acceptance/frontend/users_spec.rb,spec/acceptance/frontend/team_members_spec.rb]'
}
spb_usr() {
	sp exec -a $BACKEND_APP rails r script/marketing/create_user.rb -- "$@"
}

# spf
FRONTEND_DIR=~/Development/simplepractice-frontend
FRONTEND_APP=simplepractice-frontend
spf_cd() {
	cd $FRONTEND_DIR
}
spf_nvim() {
	spf_cd
	nvim $FRONTEND_DIR
}
spf_restart() {
	sp restart -a $FRONTEND_APP --frontend
	spf_attach
}
spf_attach() {
	sp attach -a $FRONTEND_APP
}
spf_bash() {
	sp exec -a $FRONTEND_APP bash
}
spf_yarn() {
	if [ $1 = true ]; then
		shift
		docker exec -it -e COVERAGE=true $FRONTEND_APP yarn test --serve -f 'dummy test'
	else
		shift
		docker exec -it $FRONTEND_APP yarn test --serve -f 'dummy test'
	fi
}

# sps
SSO_DIR=~/Development/sp-sso-account
SSO_APP=sp-sso-account
sps_cd() {
	cd $SSO_DIR
}
sps_nvim() {
	sps_cd
	nvim $SSO_DIR
}
sps_restart() {
	sp restart -a $SSO_APP --backend
	sps_attach
}
sps_attach() {
	sp attach -a $SSO_APP
}
sps_bash() {
	sp exec -a $SSO_APP bash
}
sps_rails() {
	sp exec -a $SSO_APP rails console
}
sps_mysql() {
	sp exec -a $SSO_APP mysql -h mysql.local -u root $SSO_APP
}
sps_rspec() {
	docker exec -it -e rails_env=test $SSO_APP bundle exec rspec $1
}

