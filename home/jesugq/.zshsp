# sp
QUEEN_DIR=~/Development/
spq() {
  tmux rename-window "sp"
	cd $QUEEN_DIR
  nvim .
}
spqcd() {
	cd $QUEEN_DIR
}
spqmap() {
	cd $QUEEN_DIR
	hidutil property --set '{"UserKeyMapping":[
	  {"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E0},
	  {"HIDKeyboardModifierMappingSrc":0x700000029,"HIDKeyboardModifierMappingDst":0x7000000E0}
	]}'
}
spqaic() {
  tmux rename-window "spqaic"
	cd $QUEEN_DIR
	agent
}
spqaig() {
  tmux rename-window "spqaig"
	cd $QUEEN_DIR
	agy
}

# spd
DOCKER_DIR=~/Development/docker-dev
spd() {
  tmux rename-window "spd"
	cd $DOCKER_DIR
  nvim .
}
spdcd() {
	cd $DOCKER_DIR
}
spdapp() {
  tmux rename-window "spdapp"
	cd $DOCKER_DIR
	ssh-add ~/.ssh/id_ed25519
	git pull
	sp apps:sync
	sp stop
	sp start
}
spdaws() {
  aws sso login --profile staging
}

# spb
BACKEND_DIR=~/Development/simplepractice
BACKEND_APP=simplepractice
spb() {
  tmux rename-window "spb"
	cd $BACKEND_DIR
  nvim .
}
spbcd() {
	cd $BACKEND_DIR
}
spbrld() {
  tmux rename-window "spbrld"
	sp restart -a $BACKEND_APP --backend
	spb_attach
}
spblog() {
  tmux rename-window "spblog"
	sp attach -a $BACKEND_APP
}
spbbash() {
  tmux rename-window "spbbash"
	sp exec -a $BACKEND_APP bash
}
spbrails() {
  tmux rename-window "spbrails"
	sp exec -a $BACKEND_APP rails console
}
spbmysql() {
  tmux rename-window "spbmysql"
	sp exec -a $BACKEND_APP mysql -h mysql.local -u root $BACKEND_APP
}
spbrspec() {
  tmux rename-window "spbrspec"
	if [ $1 = true ]; then
		shift
		docker exec -it -e COVERAGE=true $BACKEND_APP bundle exec rspec "$@"
	else
		shift
		docker exec -it $BACKEND_APP bundle exec rspec "$@"
	fi
}
spboas() {
  tmux rename-window "spboas"
	sp exec -a $BACKEND_APP rails 'oas:generate[spec/acceptance/frontend/users_spec.rb,spec/acceptance/frontend/team_members_spec.rb]'
}
spbusr() {
  tmux rename-window "spbusr"
	sp exec -a $BACKEND_APP rails r script/marketing/create_user.rb -- "$@"
}

# spf
FRONTEND_DIR=~/Development/frontend
FRONTEND_APP=simplepractice-frontend
spf() {
  tmux rename-window "spf"
	cd $FRONTEND_DIR
	nvim .
}
spfcd() {
  cd $FRONTEND_DIR
}
spfrld() {
  tmux rename-window "spfrld"
	sp restart -a $FRONTEND_APP --frontend
	spf_attach
}
spflog() {
  tmux rename-window "spflog"
	sp attach -a $FRONTEND_APP
}
spfbash() {
  tmux rename-window "spfbash"
	sp exec -a $FRONTEND_APP bash
}
spfyarn() {
  tmux rename-window "spfyarn"
	if [ $1 = true ]; then
		shift
		docker exec -it -e COVERAGE=true $FRONTEND_APP yarn test --serve -f 'dummy test'
	else
		shift
		docker exec -it $FRONTEND_APP yarn test --serve -f 'dummy test'
	fi
}

# sps
SSO_DIR=~/Development/sp-sso-account
SSO_APP=sp-sso-account
sps() {
  tmux rename-window "sps"
  cd $SSO_DIR
	nvim .
}
spscd() {
  cd $SSO_DIR
}
spsrld() {
  tmux rename-window "spsrld"
	sp restart -a $SSO_APP --backend
	sps_attach
}
spslog() {
  tmux rename-window "spslog"
	sp attach -a $SSO_APP
}
spsbash() {
  tmux rename-window "spsbash"
	sp exec -a $SSO_APP bash
}
spsrails() {
  tmux rename-window "spsrails"
	sp exec -a $SSO_APP rails console
}
spsmysql() {
  tmux rename-window "spsmysql"
	sp exec -a $SSO_APP mysql -h mysql.local -u root $SSO_APP
}
spsrspec() {
  tmux rename-window "spsrspec"
	docker exec -it -e rails_env=test $SSO_APP bundle exec rspec $1
}

