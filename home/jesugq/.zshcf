# cf
CF_DIR=$HOME/Development/config
cf_cd() {
	cd $CF_DIR
}
cf_nvim() {
	cf_cd
	nvim .
}
cf_reload() {
	cf_cd
	sudo rsync -av etc/ /etc/
	rsync -av home/jesugq/ $HOME/

	source $HOME/.zshac
	source $HOME/.zshcf
	source $HOME/.zshnv
    source $HOME/.zshsp
}
alias cf_logid_restart="sudo systemctl restart logid"
alias cf_tmux_reload="tmux source-file $HOME/tmux.conf"
alias cf_keyd_reload="sudo keyd reload"
alias cf_keyd_monitor="sudo keyd monitor"
alias cf_plasma_reload="systemctl --user restart plasma-plasmashell.service"

# cf_org
if [[ "$OSTYPE" == "darwin"* ]]; then
    CF_ORG_DIR=$HOME/Development/orgmode
else
    CF_ORG_DIR=$HOME/Sync/Apps/Orgmode
fi
cf_org_cd() {
	cd $CF_ORG_DIR
}
cf_org_nvim() {
	cf_org_cd
	nvim .
}

# cf_mark
if [[ "$OSTYPE" == "darwin"* ]]; then
    CF_MARK_DIR=$HOME/Development/markdown
else
    CF_MARK_DIR=$HOME/Sync/Apps/Markdown
fi
cf_mark_cd() {
	cd $CF_MARK_DIR
}
cf_mark_nvim() {
	cf_mark_cd
	nvim .
}

