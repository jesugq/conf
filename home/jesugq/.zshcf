# cf
CF_DIR=~/Development/config
cf_cd() {
	cd $CF_DIR
}
cf_nvim() {
	cd $CF_DIR
}

# cf_zshjq
ZSHJQ_DIR=~/.zshjq
cf_zshjq_config() {
	nvim $ZSHJQ_DIR
}
cf_zshjq_reload() {
	source $ZSHJQ_DIR
}
cf_zshjq_to_local() {
	cp $CF_DIR$ZSHJQ_DIR $ZSHJQ_DIR
}
cf_zshjq_to_repos() {
	cp $ZSHJQ_DIR $CF_DIR$ZSHJQ_DIR
}

# cf_zshcf
ZSHCF_DIR=~/.zshcf
cf_zshcf_config() {
	nvim $ZSHCF_DIR
}
cf_zshcf_reload() {
