# cf
CF_DIR=$HOME/Development/config
cf_cd() {
	cd $CF_DIR
}
cf_nvim() {
	cf_cd
	nvim .
}
cf_reload() {
	cf_cd
	sudo rsync -av etc/ /etc/
	rsync -av home/jesugq/ $HOME/

	source $HOME/.zshac
	source $HOME/.zshcf
	source $HOME/.zshnv
    source $HOME/.zshsp
}
alias cf_logid_restart="sudo systemctl restart logid"
alias cf_tmux_reload="tmux source-file $HOME/tmux.conf"
alias cf_keyd_reload="sudo keyd reload"
alias cf_keyd_monitor="sudo keyd monitor"
alias cf_plasma_reload="systemctl --user restart plasma-plasmashell.service"

