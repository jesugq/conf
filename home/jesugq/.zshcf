# nv_zshcf
ZSHDM_DIR=~/.zshdm
cf_zshdm_config() {
	nvim $ZSHDM_DIR
}
cf_zshdm_reload() {
	source $ZSHDM_DIR
}
cf_zshdm_to_local() {
	cp $CF_DIR$ZSHDM_DIR $ZSHDM_DIR
}
cf_zshdm_to_repos() {
