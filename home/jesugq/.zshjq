alias logidrld="sudo systemctl restart logid"
alias plasmarld="systemctl --user restart plasma-plasmashell.service"

function fm() {
  tmux rename-window fm
  somafm
}

function fd() {
  cd $HOME
  tmux rename-window fd
  feedr
}
function fdcd() {
  cd $HOME
}

CL_ORIGIN_DIR=$HOME/.config/calcurse
if [[ "$OSTYPE" == "darwin"* ]]; then
  CL_TARGET_DIR=$HOME/Development/calcurse
else
  CL_TARGET_DIR=$HOME/Sync/Apps/Calcurse
fi
function cl() {
  cd $CL_TARGET_DIR
  tmux rename-window cl
  calcurse
}
function clcd() {
  cd $CL_TARGET_DIR
}
function clrld() {
  calcurse-caldav
  rsync -av $CL_ORIGIN_DIR/ $CL_TARGET_DIR/
}

unalias md
if [[ "$OSTYPE" == "darwin"* ]]; then
  MD_DIR=$HOME/Development/markdown
else
  MD_DIR=$HOME/Sync/Apps/Markdown
fi
function md() {
	cd $MD_DIR
  tmux rename-window md
	nvim .
}
function mdcd() {
	cd $MD_DIR
}

if [[ "$OSTYPE" == "darwin"* ]]; then
  OG_DIR=$HOME/Development/orgmode
else
  OG_DIR=$HOME/Sync/Apps/Orgmode
fi
function og() {
	cd $OG_DIR
  tmux rename-window og
	nvim .
}
function ogcd() {
	cd $OG_DIR
}

CF_DIR=$HOME/Development/config
function cf() {
	cd $CF_DIR
  tmux rename-window cf
	nvim .
}
function cfcd() {
	cd $CF_DIR
}
function cfrld() {
  cd $CF_DIR
	sudo rsync -av etc/ /etc/
	rsync -av home/jesugq/ $HOME/
}
function cfsrc() {
  cd $CF_DIR
	source $HOME/.zshrc
}

NV_DIR=$HOME/.config/nvim
function nv() {
	cd $NV_DIR
  tmux rename-window nv
	nvim .
}
function nvcd() {
	cd $NV_DIR
}

AMIG_DIR=$HOME/Development/cozy-animals-backend
function amig() {
	cd $AMIG_DIR
	nvim .
}
function amigcd() {
	cd $AMIG_DIR
}

function aic() {
  agent
}
function aig() {
  agy
}

function yz() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}

function lg() {
	lazygit
}

function tm() {
  cd $HOME
  tmux new-session -s "$1" 2>/dev/null || tmux attach-session -t "$1"
}
function tmls() {
  cd $HOME
  tmux ls
}

