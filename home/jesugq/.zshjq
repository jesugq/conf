#!/usr/bin/env bash

alias logidrld="sudo systemctl restart logid"
alias plasmarld="systemctl --user restart plasma-plasmashell.service"

# shared
function fm() {
  cd $HOME
  safe-tmux-rename fm
  somafm
}
function fe() {
  cd $HOME
  safe-tmux-rename fe
  feedr
}
function ferld() {
  cd $HOME
  safe-tmux-rename fe
  feedr --import $HOME/Sync/Apps/FeedFlow/Feeds.opml
}
function cl() {
  cd $HOME
  safe-tmux-rename cl
  calcurse
}
function clrld() {
  cd $HOME
  safe-tmux-rename cl
  calcurse-caldav --debug --verbose
}
function snc() {
  "$HOME/.script/snc"
  "$HOME/.script/afk"
}
function afk() {
  "$HOME/.script/afk"
}

# local
unalias md
if [[ "$OSTYPE" == "darwin"* ]]; then
  MD_DIR=$HOME/Development/markdown
else
  MD_DIR=$HOME/Sync/Apps/Markdown
fi
function md() {
  cd $MD_DIR
  safe-tmux-rename md
}
if [[ "$OSTYPE" == "darwin"* ]]; then
  OG_DIR=$HOME/Development/orgmode
else
  OG_DIR=$HOME/Sync/Apps/Orgmode
fi
function og() {
	cd $OG_DIR
  safe-tmux-rename og
}

# repos
CF_DIR=$HOME/Development/conf
function cf() {
	cd $CF_DIR
  safe-tmux-rename cf
}
function cfrld() {
  cd $CF_DIR
  safe-tmux-rename cf
	sudo rsync -av etc/ /etc/
	rsync -av home/jesugq/ $HOME/
}
function cfsrc() {
  cd $CF_DIR
  safe-tmux-rename cf
	source $HOME/.zshjq
	source $HOME/.zshai
  source $HOME/.zshsp
  tmux source-file $HOME/.tmux.conf
}
NM_DIR=$HOME/.config/nvim
function nm() {
	cd $NM_DIR
  safe-tmux-rename nm
}

function yz() {
  safe-tmux-rename find
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}
function ne() {
  safe-tmux-rename code
  nvim .
}
function lg() {
  safe-tmux-rename pull
  lazygit
}
