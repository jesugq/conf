alias jq-zsh='vim ~/.zshjq'
alias jq-src="source ~/.zshjq"
alias jq-man="vim -c 'h user-manual|only'"


alias jq-restart-logid='sudo systemctl restart logid'
alias jq-restart-plasma='systemctl --user restart plasma-plasmashell'


alias jq-reload-doom='~/.config/emacs/bin/doom sync'
alias jq-reload-keyd='sudo keyd reload'


alias jq-edit-logid='sudo vim /etc/logid.cfg'
alias jq-edit-doom='vim ~/.config/doom/config.el'
alias jq-edit-keyd='sudo vim /etc/keyd/default.conf'

