#!/usr/bin/env bash

alias logidrld="sudo systemctl restart logid"
alias plasmarld="systemctl --user restart plasma-plasmashell.service"

# tmux
function macos() {
	hidutil property --set '{"UserKeyMapping":[
	  {"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E0},
	  {"HIDKeyboardModifierMappingSrc":0x700000029,"HIDKeyboardModifierMappingDst":0x7000000E0}
	]}'
}
function tm() {
  cd $HOME
  clear
  tmux new-session -s "$1" 2>/dev/null || tmux attach-session -t "$1"
}
function tmls() {
  cd $HOME
  tmux ls
}
function tmrm() {
  tmux kill-session -t "$1"
}

# shared
function fm() {
  cd $HOME
  tmux rename-window fm
  somafm
}
function fe() {
  cd $HOME
  tmux rename-window fe
  feedr
}
function ferld() {
  cd $HOME
  tmux rename-window fe
  feedr --import $HOME/Sync/Apps/FeedFlow/Feeds.opml
}
function cl() {
  cd $HOME
  tmux rename-window cl
  calcurse
}
function clrld() {
  cd $HOME
  tmux rename-window cl
  calcurse-caldav --debug --verbose
}
function snc() {
  "$HOME/.script/snc"
  "$HOME/.script/afk"
}
function afk() {
  "$HOME/.script/afk"
}

# local
unalias md
if [[ "$OSTYPE" == "darwin"* ]]; then
  MD_DIR=$HOME/Development/markdown
else
  MD_DIR=$HOME/Sync/Apps/Markdown
fi
function md() {
  cd $MD_DIR
  tmux rename-window md
}
if [[ "$OSTYPE" == "darwin"* ]]; then
  OG_DIR=$HOME/Development/orgmode
else
  OG_DIR=$HOME/Sync/Apps/Orgmode
fi
function og() {
	cd $OG_DIR
  tmux rename-window og
}

# repos
CF_DIR=$HOME/Development/conf
function cf() {
	cd $CF_DIR
  tmux rename-window cf
}
function cfrld() {
  cd $CF_DIR
  tmux rename-window cf
	sudo rsync -av etc/ /etc/
	rsync -av home/jesugq/ $HOME/
}
function cfsrc() {
  cd $CF_DIR
  tmux rename-window cf
	source $HOME/.zshjq
  source $HOME/.zshsp
  tmux source-file $HOME/.tmux.conf
}
NM_DIR=$HOME/.config/nvim
function nm() {
	cd $NM_DIR
  tmux rename-window nm
}

# utils
TM_SPC=(md og cf nm)
function tmux-rename-window() {
  local name
  local special
  name=$(tmux display-message -p '#W' 2>/dev/null)
  for special in "${TM_SPC[@]}"; do
    [[ "$name" == "$special" ]] && return 0
  done
  tmux rename-window "$1"
}
function yz() {
  tmux-rename-window find
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}
function ne() {
  tmux-rename-window code
  nvim .
}
function lg() {
  tmux-rename-window pull
  lazygit
}

function ai() {
  tmux-rename-window vibe
  local options=(
    "Cursor|agent"
    "Codex|codex"
    "Copilot|copilot"
    "Antigravity|agy"
    "Qwen|qwen"
    "Open Code|opencode"
    "Claude|claude"
  )

  local labels=()
  for item in "${options[@]}"; do
    labels+=("${item%%|*}")
  done

  local selected_label
  selected_label=$(gum choose "${labels[@]}" --header "Which AI do you still have tokens for?:")

  if [ -n "$selected_label" ]; then
    for item in "${options[@]}"; do
      local label="${item%%|*}"
      local cmd="${item#*|}"
      if [ "$label" = "$selected_label" ]; then
        echo "Running $label ($cmd)..."
        eval "$cmd"
        break
      fi
    done
  fi
}
