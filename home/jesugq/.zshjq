#!/usr/bin/env bash

alias logidrld="sudo systemctl restart logid"
alias plasmarld="systemctl --user restart plasma-plasmashell.service"

# shared
function sfm() {
  safe-tmux-rename sfm
  somafm
}
function afk() {
  safe-tmux-rename afk
  "$HOME/.script/snc"
  "$HOME/.script/afk"
}

# local
if [[ "$OSTYPE" == "darwin"* ]]; then
  MD_DIR=$HOME/Development/markdown
else
  MD_DIR=$HOME/Sync/Apps/Markdown
fi
unalias md
function md() {
  safe-tmux-rename md
  cd $MD_DIR
}
if [[ "$OSTYPE" == "darwin"* ]]; then
  OG_DIR=$HOME/Development/orgmode
else
  OG_DIR=$HOME/Sync/Apps/Orgmode
fi
function og() {
  safe-tmux-rename og
	cd $OG_DIR
}

# repos
CF_DIR=$HOME/Development/conf
function cf() {
  safe-tmux-rename cf
	cd $CF_DIR
}
function cfrld() {
  safe-tmux-rename cf
  cd $CF_DIR
	sudo rsync -av etc/ /etc/
	rsync -av home/jesugq/ $HOME/
}
function cfsrc() {
  safe-tmux-rename cf
  cd $CF_DIR
	source $HOME/.zshjq
	source $HOME/.zshai
  source $HOME/.zshsp
  tmux source-file $HOME/.config/tmux/tmux.conf
}
NM_DIR=$HOME/.config/nvim
function nm() {
  safe-tmux-rename nm
	cd $NM_DIR
}

function yz() {
  safe-tmux-rename find
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}
function ne() {
  safe-tmux-rename code
  nvim .
}
function lg() {
  safe-tmux-rename pull
  lazygit
}
