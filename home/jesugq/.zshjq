alias logidrld="sudo systemctl restart logid"
alias plasmarld="systemctl --user restart plasma-plasmashell.service"

if [[ "$OSTYPE" == "darwin"* ]]; then
    OG_DIR=$HOME/Development/orgmode
else
    OG_DIR=$HOME/Sync/Apps/Orgmode
fi
function og() {
	cd $OG_DIR
	nvim .
}
function ogcd() {
	cd $OG_DIR
}

unalias md
if [[ "$OSTYPE" == "darwin"* ]]; then
    MD_DIR=$HOME/Development/markdown
else
    MD_DIR=$HOME/Sync/Apps/Markdown
fi
function md() {
	cd $MD_DIR
	nvim .
}
function mdcd() {
	cd $MD_DIR
}

CF_DIR=$HOME/Development/config
function cf() {
	cd $CF_DIR
	nvim .
}
function cfcd() {
	cd $CF_DIR
}
function cfrld() {
  cd $CF_DIR
	sudo rsync -av etc/ /etc/
	rsync -av home/jesugq/ $HOME/
}
function cfsrc() {
  cd $CF_DIR
	source $HOME/.zshrc
}

NV_DIR=$HOME/.config/nvim
function nv() {
	cd $NV_DIR
	nvim .
}
function nvcd() {
	cd $NV_DIR
}

AMIG_DIR=$HOME/Development/cozy-animals-backend
function amig() {
	cd $AMIG_DIR
	nvim .
}
function amigcd() {
	cd $AMIG_DIR
}

function aic() {
  agent
}
function aig() {
  agy
}

function yz() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}

function lg() {
	lazygit
}

function fm() {
  somafm
}

function tm() {
  tmux new-session -s "$1" 2>/dev/null || tmux attach-session -t "$1"
}
function tmls() {
  tmux ls
}

