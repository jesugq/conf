# theme
theme = Ryuuko

# font
font-family = "Maple Mono NF"
font-size = 24.0

# window
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0

# macos support
# cmd+shift+[ -> alt+{
# cmd+shift+] -> alt+}
keybind = super+shift+left_bracket=csi:123;3u
keybind = super+shift+right_bracket=csi:125;3u

# globe support
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
