function yz() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

function lg() {
	lazygit
}

if [[ "$OSTYPE" == "darwin"* ]]; then
    ORG_DIR=$HOME/Development/orgmode
else
    ORG_DIR=$HOME/Sync/Apps/Orgmode
fi
function org() {
	cd $ORG_DIR
	nvim .
}

unalias md
if [[ "$OSTYPE" == "darwin"* ]]; then
    MD_DIR=$HOME/Development/markdown
else
    MD_DIR=$HOME/Sync/Apps/Markdown
fi
function md() {
	cd $MD_DIR
	nvim .
}

function aic() {
  cursor agent
}

function aig() {
  gemini
}
