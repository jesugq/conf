#!/usr/bin/env bash

# tmux
function macos() {
	hidutil property --set '{"UserKeyMapping":[
	  {"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E0},
	  {"HIDKeyboardModifierMappingSrc":0x700000029,"HIDKeyboardModifierMappingDst":0x7000000E0}
	]}'
}
function tm() {
  local session="${1:-jesugq}"
  cd $HOME
  clear
  tmux new-session -s "$session" 2>/dev/null || tmux attach-session -t "$session"
}
function tmls() {
  cd $HOME
  tmux ls
}
function tmrm() {
  tmux kill-session -t "$1"
}

# pane-tmux
function pane-tmux-main() {
  "$@"
}
function pane-tmux-side() {
  local command side focus flags target
  [[ $# -gt 2 ]] || return 2
  side=$1
  focus=$2
  shift 2
  case $side in
    left) flags=(-h -b -l 33% -P -F '#{pane_id}') ;;
    right) flags=(-h -l 33% -P -F '#{pane_id}') ;;
    *) return 2 ;;
  esac
  case $focus in
    main|side) ;;
    *) return 2 ;;
  esac
  PANE_TMUX_MAIN_PANE=$(tmux display-message -p '#{pane_id}') || return
  printf -v command '%q ' "$@"
  command=${command% }
  PANE_TMUX_SIDE_PANE=$(tmux split-window "${flags[@]}" "$command") || return
  if [[ $focus == main ]]; then
    target=$PANE_TMUX_MAIN_PANE
  else
    target=$PANE_TMUX_SIDE_PANE
  fi
  tmux select-pane -t "$target"
}

# utils
function tmux-rename-append() {
  local name
  local first_word
  name=$(tmux display-message -p '#W' 2>/dev/null)
  first_word=${name%%-*}
  tmux rename-window "${first_word}-$1"
}
function tmux-rename-create() {
  tmux rename-window "$1"
}
