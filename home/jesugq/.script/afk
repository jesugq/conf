#!/usr/bin/env bash

source "$HOME/.zshtm"
safe-tmux-rename afk

if [[ "${OSTYPE:-}" == darwin* ]]; then
  arch="$HOME/.binary/drift_darwin"
else
  arch="$HOME/.binary/drift_linux"
fi

scenes=(waveform constellation rain particles pipes orrery starfield dvd boids bonsai)
themes=(cosmic nord dracula catppuccin gruvbox forest wildberries mono rosepine)

for ((i=${#scenes[@]}-1; i>0; i--)); do
  j=$((RANDOM % (i+1)))
  tmp=${scenes[i]}
  scenes[i]=${scenes[j]}
  scenes[j]=$tmp
done
unset i j tmp

IFS=,
scene="${scenes[*]}"
unset IFS
theme="${themes[RANDOM % ${#themes[@]}]}"

pane-tmux-side "$HOME/.script/thinking_cursor.py" "Cursoring"
pane-tmux-more "$HOME/.script/thinking_claude.py" "Clauding"
pane-tmux-more "$HOME/.script/thinking_copilot.py" "Copiloting"
pane-tmux-more "$HOME/.script/thinking_antigravity.py" "Graviting"
pane-tmux-same

pane-tmux-main "$arch" --scene "$scene" --theme "$theme" --duration 10
