#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
in="$(mktemp "${TMPDIR:-/tmp}/mermaid-mode.XXXXXX.mmd")"
out="$(mktemp "${TMPDIR:-/tmp}/mermaid-mode.XXXXXX.svg")"
cleanup() { rm -f "$in" "$out"; }
trap cleanup EXIT

if [[ "${1:-}" == "-" || -z "${1:-}" ]]; then
  cat >"$in"
else
  cat "$1" >"$in"
fi

mmdc -i "$in" -o "$out" -c "$here/config.json" -b transparent -q

python3 - "$out" <<'PY'
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text()
match = re.search(r"<svg\b[^>]*>", text, re.I)
if not match:
    sys.stdout.write(text)
    raise SystemExit(0)

tag = match.group(0)
viewbox = re.search(r'viewBox="([^"]+)"', tag)
if viewbox:
    parts = viewbox.group(1).split()
    if len(parts) == 4:
        _x, _y, width, height = parts

        def set_attr(source: str, name: str, value: str) -> str:
            if re.search(fr'\b{name}="[^"]*"', source):
                return re.sub(fr'\b{name}="[^"]*"', f'{name}="{value}"', source)
            return source[:-1] + f' {name}="{value}">'

        tag = set_attr(tag, "width", width)
        tag = set_attr(tag, "height", height)

tag = re.sub(r'\sstyle="[^"]*"', "", tag)
tag = tag[:-1] + ' style="background-color: transparent;">'
sys.stdout.write(text[: match.start()] + tag + text[match.end() :])
PY
